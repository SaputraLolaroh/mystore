# Neon pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Use a long random secret in production
AUTH_SECRET=ganti-dengan-secret-acak-panjang
# Optional: create an admin account at database initialization
ADMIN_EMAIL=admin@domain-anda.com
ADMIN_PASSWORD=ganti-dengan-password-admin-kuat
